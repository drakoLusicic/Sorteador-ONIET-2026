# Configuración del sorteador.
# Copiá este archivo como ".env" (en la misma carpeta) y completá los datos.
# Sin archivo .env, el sorteador usa una base SQLite local con datos de ejemplo.

# --- Base de datos MySQL/MariaDB (en cPanel: "Bases de datos MySQL") ---------
# En cPanel el nombre de la base y el del usuario llevan adelante el usuario
# de la cuenta, por ejemplo: micuenta_sorteo y micuenta_admin.
# En esa base hay que importar antes (phpMyAdmin) el script de la base, que
# crea las tablas estudiantes, premios y ganadores.
SORTEADOR_DB_NOMBRE=micuenta_sorteo
SORTEADOR_DB_USUARIO=micuenta_admin
SORTEADOR_DB_CLAVE=la-contraseña-del-usuario-de-la-base
SORTEADOR_DB_HOST=localhost
# SORTEADOR_DB_PUERTO=3306

# En lugar de los datos anteriores se puede dar la URL completa (por ejemplo,
# para PostgreSQL). Si la contraseña tiene símbolos, hay que escaparlos.
# SORTEADOR_DB_URL=mysql+pymysql://usuario:clave@localhost/base?charset=utf8mb4

# --- Ingreso (usuario y contraseña para todo el sorteador) --------------------
# Los usuarios y contraseñas no van acá: están en la base, en la tabla
# administradores (se crea importando administradores.sql).

# Clave para firmar la sesión: un texto largo y al azar.
# Se puede generar con:  python -c "import secrets; print(secrets.token_hex(32))"
# Si no se completa, se genera una al azar y se guarda en la base de datos.
# SORTEADOR_CLAVE_SECRETA=

# La sesión solo viaja por https. Poner 0 únicamente si el
# sitio todavía no tiene certificado (si no, no se puede entrar).
# SORTEADOR_COOKIE_SEGURA=1

# Zona horaria para la hora de cada ganador.
# SORTEADOR_ZONA_HORARIA=America/Argentina/Cordoba
